<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="600" Width="1000">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3.8*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="NameApp"
                   VerticalAlignment="Center"
                   Margin="10"/>

        <Button Grid.Row="0" Grid.Column="1"
                Content="+"
                Width="35" Height="35"
                HorizontalAlignment="Right"
                Margin="5"
                Click="Add_Click"/>

        <!-- LEFT PANEL -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
            <Button Content="Home Page" Margin="0,5"/>
            <Button Content="Calendar" Margin="0,5"/>

            <TextBlock Text="List of courses" Margin="0,10,0,5"/>

            <Button Content="Course 1"  Style="{StaticResource FlatButton}"/>
            <Button Content="Course 2" Style="{StaticResource FlatButton}"/>
            <Button Content="Course 3"  Style="{StaticResource FlatButton}"/>
            
        </StackPanel>

        <!-- MAIN TABLE -->
        <DataGrid Grid.Row="1" Grid.Column="1"
                  x:Name="TasksGrid"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  Margin="5">

            <DataGrid.Columns>

                <!-- Task Name -->
                <DataGridTextColumn Header="Task"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                <!-- Progress -->
                <DataGridTemplateColumn Header="Progress" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ProgressBar Value="{Binding Progress}"
                                         Height="20"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Deadline -->
                <DataGridTextColumn Header="Deadline"
                                    Binding="{Binding Deadline}"
                                    Width="150"/>

                <!-- Buttons -->
                <DataGridTemplateColumn Header="Actions" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">

                                <Button Content="Edit"
                                        Margin="2"
                                        Padding="5,2"
                                        Click="Edit_Click"/>

                                <Button Content="Delete"
                                        Margin="2"
                                        Padding="5,2"
                                        Click="Delete_Click"/>

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>