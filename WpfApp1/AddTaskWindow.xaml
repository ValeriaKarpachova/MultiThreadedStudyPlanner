<Window x:Class="WpfApp1.AddTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Task" Height="300" Width="300">

	<StackPanel Margin="10">

		<TextBlock Text="Task Name"/>
		<TextBox x:Name="NameBox" Margin="0,5"/>

		<TextBlock Text="Progress (%)"/>
		<TextBox x:Name="ProgressBox" Margin="0,5"/>

		<TextBlock Text="Deadline"/>
		<DatePicker x:Name="DeadlinePicker" Margin="0,5"/>

		<Button Content="Add"
                Margin="0,10"
                Click="Add_Click"/>

	</StackPanel>
</Window>