<Window x:Class="WpfApp1.EditTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Task" Height="430" Width="350" FontSize="16" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <StackPanel Margin="10">

        <TextBlock Text="Task Name"/>
        <TextBox x:Name="NameBox" Margin="0,5"/>

        <TextBlock Text="Description"/>
        <TextBox x:Name="Description" Margin="0,5"/>

        <TextBlock Text="Progress (%)"/>
        <TextBox x:Name="ProgressBox" Margin="0,5"/>

        <TextBlock Text="Deadline"/>
        <DatePicker x:Name="DeadlinePicker" Margin="0,5"/>

        <TextBlock Text="Task Type"/>
        <ComboBox x:Name="TypeBox" Margin="0,5">
            <ComboBoxItem Content="Lecture"/>
            <ComboBoxItem Content="Laboratory Work"/>
            <ComboBoxItem Content="Independent Study"/>
            <ComboBoxItem Content="Test"/>
            <ComboBoxItem Content="Course Project"/>
            <ComboBoxItem Content="Diploma Project"/>
            <ComboBoxItem Content="Seminar"/>
            <ComboBoxItem Content="Practical Class"/>
            <ComboBoxItem Content="Homework"/>
            <ComboBoxItem Content="Essay"/>
            <ComboBoxItem Content="Presentation"/>
            <ComboBoxItem Content="Exam"/>
            <ComboBoxItem Content="Quiz"/>
            <ComboBoxItem Content="Research Paper"/>
            <ComboBoxItem Content="Internship"/>
        </ComboBox>
        
        <Button Content="Edit"
                Margin="0,10"
                Click="Edit_Click"/>

    </StackPanel>
</Window>