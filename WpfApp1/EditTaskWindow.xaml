<Window x:Class="WpfApp1.EditTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Task" Height="300" Width="300" FontSize="16" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <StackPanel Margin="10">

        <TextBlock Text="Task Name"/>
        <TextBox x:Name="NameBox" Margin="0,5"/>

        <TextBlock Text="Progress (%)"/>
        <TextBox x:Name="ProgressBox" Margin="0,5"/>

        <TextBlock Text="Deadline"/>
        <DatePicker x:Name="DeadlinePicker" Margin="0,5"/>

        <Button Content="Edit"
                Margin="0,10"
                Click="Edit_Click"/>

    </StackPanel>
</Window>