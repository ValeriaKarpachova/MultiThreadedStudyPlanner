<Window x:Class="WpfApp2.Views.AddSubjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новий предмет" Height="220" Width="320"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="Назва предмету" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,12"/>

        <TextBlock Text="Колір" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal" x:Name="ColorPicker" Margin="0,0,0,16">
            <RadioButton Tag="#534AB7" GroupName="col" IsChecked="True">
                <Border Width="20" Height="20" Background="#534AB7" CornerRadius="3"/>
            </RadioButton>
            <RadioButton Tag="#22A06B" GroupName="col" Margin="6,0,0,0">
                <Border Width="20" Height="20" Background="#22A06B" CornerRadius="3"/>
            </RadioButton>
            <RadioButton Tag="#E2483D" GroupName="col" Margin="6,0,0,0">
                <Border Width="20" Height="20" Background="#E2483D" CornerRadius="3"/>
            </RadioButton>
            <RadioButton Tag="#0065FF" GroupName="col" Margin="6,0,0,0">
                <Border Width="20" Height="20" Background="#0065FF" CornerRadius="3"/>
            </RadioButton>
            <RadioButton Tag="#FF8C00" GroupName="col" Margin="6,0,0,0">
                <Border Width="20" Height="20" Background="#FF8C00" CornerRadius="3"/>
            </RadioButton>
        </StackPanel>

        <Button Content="Створити" Click="Create_Click"/>
    </StackPanel>
</Window>