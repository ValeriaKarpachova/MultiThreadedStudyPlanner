<Window x:Class="WpfApp2.Views.AddSubjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новий предмет" Height="280" Width="380"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" WindowStyle="None">
     
     <Border Background="White" 
            CornerRadius="12" 
            BorderThickness="0">
        
        <Border BorderBrush="#E0DEFF" 
                BorderThickness="1" 
                CornerRadius="12"
                Background="White">

        <StackPanel Margin="10">
            <Border Background="#534AB7" 
                        CornerRadius="8,8,0,0" 
                        Margin="-10,-10,-10,0"
                        Height="40"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <TextBlock Text="Додати завдання" 
                                   FontWeight="SemiBold" 
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" FontSize="18" />
                        <Button Content="✕" 
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            Click="Close_Click"
                            Style="{StaticResource PrimaryButton}"/>
                    </Grid>
                </Border>
            <TextBlock Text="Назва предмету" Margin="0,10,0,10"
                        FontWeight="SemiBold" FontSize="16" />
            <TextBox x:Name="NameBox" Margin="0,0,0,16"
                      Padding="6,4" FontSize="16"/>

            <TextBlock Text="Колір" Margin="0,0,0,8"
                        FontWeight="SemiBold" FontSize="16" />
            <StackPanel Orientation="Horizontal" x:Name="ColorPicker" Margin="0,0,0,20">
                <RadioButton Tag="#534AB7" GroupName="col" IsChecked="True"
                             Click="ColorRadio_Click" Margin="0,0,8,0">
                    <Border Width="28" Height="28" Background="#534AB7" CornerRadius="6"/>
                </RadioButton>
                <RadioButton Tag="#22A06B" GroupName="col"
                             Click="ColorRadio_Click" Margin="0,0,8,0">
                    <Border Width="28" Height="28" Background="#22A06B" CornerRadius="6"/>
                </RadioButton>
                <RadioButton Tag="#E2483D" GroupName="col"
                             Click="ColorRadio_Click" Margin="0,0,8,0">
                    <Border Width="28" Height="28" Background="#E2483D" CornerRadius="6"/>
                </RadioButton>
                <RadioButton Tag="#0065FF" GroupName="col"
                             Click="ColorRadio_Click" Margin="0,0,8,0">
                    <Border Width="28" Height="28" Background="#0065FF" CornerRadius="6"/>
                </RadioButton>
                <RadioButton Tag="#FF8C00" GroupName="col"
                             Click="ColorRadio_Click">
                    <Border Width="28" Height="28" Background="#FF8C00" CornerRadius="6"/>
                </RadioButton>

            </StackPanel>
                <Button Content="Створити" Click="Create_Click"
                    Style="{StaticResource PrimaryButton}"
                    Padding="0,10" Height="44" FontSize="18" />
            </StackPanel>
     </Border>
    </Border>
</Window>