<UserControl x:Class="WpfApp2.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Навігація по місяцях -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="PrevButton" Content="◀" Width="32" Click="PrevMonth_Click"
                    Background="#534AB7" Foreground="White" BorderThickness="0"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#534AB7"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#6C5FC7"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock x:Name="MonthLabel" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="16,0" Width="180"
                       TextAlignment="Center" Foreground="#534AB7"/>

            <Button x:Name="NextButton" Content="▶" Width="32" Click="NextMonth_Click"
                    Background="#534AB7" Foreground="White" BorderThickness="0"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#534AB7"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#6C5FC7"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- Дні тижня -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="7" Margin="0,0,0,4">
            <TextBlock Text="Пн" TextAlignment="Center" FontWeight="Bold" Foreground="Gray"/>
            <TextBlock Text="Вт" TextAlignment="Center" FontWeight="Bold" Foreground="Gray"/>
            <TextBlock Text="Ср" TextAlignment="Center" FontWeight="Bold" Foreground="Gray"/>
            <TextBlock Text="Чт" TextAlignment="Center" FontWeight="Bold" Foreground="Gray"/>
            <TextBlock Text="Пт" TextAlignment="Center" FontWeight="Bold" Foreground="Gray"/>
            <TextBlock Text="Сб" TextAlignment="Center" FontWeight="Bold" Foreground="#E07070"/>
            <TextBlock Text="Нд" TextAlignment="Center" FontWeight="Bold" Foreground="#E07070"/>
        </UniformGrid>

        <!-- Сітка днів -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <UniformGrid x:Name="CalGrid" Rows="6" Columns="7"/>
        </ScrollViewer>
    </Grid>
</UserControl>