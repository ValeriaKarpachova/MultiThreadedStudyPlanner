<UserControl x:Class="WpfApp2.Views.PomodoroWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PomBtn" TargetType="Button">
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Margin"          Value="2"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="#534AB7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="8" Background="#F5F4FF" Padding="8,6">
        <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="🍅 " FontSize="12"/>
                <TextBlock x:Name="PhaseLabel" FontSize="12"
                           FontWeight="Bold" Foreground="#534AB7"/>
            </StackPanel>

            <TextBlock x:Name="TimerLabel" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,2"/>

            <ProgressBar x:Name="TimerBar" Height="4"
                         Minimum="0" Margin="0,2,0,6"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Старт -->
                <Button x:Name="StartBtn" Style="{StaticResource PomBtn}"
                        ToolTip="Старт" Click="Start_Click">
                    <Image Source="/Images/play.png" Width="18" Height="18"/>
                </Button>
                <!-- Пауза -->
                <Button Style="{StaticResource PomBtn}"
                        ToolTip="Пауза" Click="Pause_Click">
                    <Image Source="/Images/pause.png" Width="18" Height="18"/>
                </Button>
                <!-- Скинути -->
                <Button Style="{StaticResource PomBtn}"
                        ToolTip="Скинути" Click="Reset_Click">
                    <Image Source="/Images/reset.png" Width="18" Height="18"/>
                </Button>
                <!-- Пропустити -->
                <Button Style="{StaticResource PomBtn}"
                        ToolTip="Пропустити фазу" Click="Skip_Click">
                    <Image Source="/Images/skip.png" Width="18" Height="18"/>
                </Button>
            </StackPanel>

            <TextBlock x:Name="CountLabel" FontSize="10" Foreground="Gray"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
