<Window x:Class="WpfApp2.Views.SplitTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Розбити завдання" Height="480" Width="460"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold"/>
            <TextBlock x:Name="InfoText" Foreground="Gray" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Слайдер кількості частин -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Кількість частин:" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="PartsSlider" Minimum="2" Maximum="10" Value="3"
                        Width="240" TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="PartsSlider_ValueChanged"/>
                <TextBlock x:Name="PartsLabel" Margin="10,0,0,0"
                           VerticalAlignment="Center" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <!-- Заголовки колонок -->
        <Grid Grid.Row="2" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Назва частини"
                       FontSize="11" Foreground="Gray"/>
            <TextBlock Grid.Column="2" Text="Годин"
                       FontSize="11" Foreground="Gray"/>
        </Grid>

        <!-- Список частин (займає весь залишок) -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      Margin="0,0,0,12">
            <ItemsControl x:Name="SubTasksList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Index, StringFormat={}{0}.}"
                                       VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,6,0"/>
                            <TextBox Grid.Column="2"
                                     Text="{Binding Hours, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Кнопки — завжди внизу -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Скасувати" Width="100" Click="Cancel_Click" Margin="0,0,6,0"/>
            <Button Content="Розбити" Width="100"
                    Click="Confirm_Click"/>
        </StackPanel>

    </Grid>
</Window>