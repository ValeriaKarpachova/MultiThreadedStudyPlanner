<Window x:Class="WpfApp2.Views.SplitTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Розбити завдання" Height="400" Width="420"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16">

        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock x:Name="InfoText" Foreground="Gray" FontSize="12" Margin="0,0,0,14"/>

        <TextBlock Text="Кількість частин:" Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Slider x:Name="PartsSlider" Minimum="2" Maximum="10" Value="3"
                    Width="200" TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="PartsSlider_ValueChanged"/>
            <TextBlock x:Name="PartsLabel" Margin="10,0,0,0" VerticalAlignment="Center"
                       FontWeight="Bold"/>
        </StackPanel>

        <TextBlock Text="Назви частин (можна редагувати):" Margin="0,0,0,6"/>
        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SubTasksList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="{Binding Index, StringFormat={}{0}.}"
                                       Width="20" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Width="300"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Розбити" Width="100" Margin="0,0,10,0" Click="Confirm_Click"/>
            <Button Content="Скасувати" Width="100" Click="Cancel_Click"/>
        </StackPanel>

    </StackPanel>
</Window>