<Window x:Class="WpfApp2.Views.SplitPartDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Розбити частину" Height="440" Width="440"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" FontSize="14" FontWeight="Bold"/>
            <TextBlock x:Name="InfoText"  Foreground="Gray" FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Кількість частин:" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="PartsSlider" Minimum="2" Maximum="8" Value="2"
                        Width="220" TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="PartsSlider_ValueChanged"/>
                <TextBlock x:Name="PartsLabel" Margin="10,0"
                           VerticalAlignment="Center" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Назва"  FontSize="11" Foreground="Gray"/>
            <TextBlock Grid.Column="2" Text="Годин"  FontSize="11" Foreground="Gray"/>
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <ItemsControl x:Name="SubList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Index, StringFormat={}{0}.}"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Margin="0,0,6,0"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="2"
                                     Text="{Binding Hours, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Розбити"   Width="100" Margin="0,0,10,0" Click="Confirm_Click"/>
            <Button Content="Скасувати" Width="100" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>