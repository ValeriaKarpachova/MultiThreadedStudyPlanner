<Window x:Class="WpfApp2.Views.SplitPartDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Розбити частину" Height="480" Width="480"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="PurpleButton" TargetType="Button">
            <Setter Property="Background"      Value="#534AB7"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6C5FC7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3C3489"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#534AB7"/>
            <Setter Property="BorderBrush"     Value="#534AB7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0EEFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" 
            CornerRadius="12" 
            BorderThickness="0"
            >
        
        <Border BorderBrush="#E0DEFF" 
                BorderThickness="1" 
                CornerRadius="12"
                Background="White">
            
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Шапка -->
                <Border Grid.Row="0" 
                        Background="#534AB7" 
                        CornerRadius="8,8,0,0" 
                        Margin="-16,-16,-16,0"
                        Height="40"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <TextBlock Text="Розбити частину" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                        <Button Content="✕" 
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            Click="Close_Click"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,16,0,12">
                    <TextBlock x:Name="TitleText"  FontWeight="Bold"/>
                    <TextBlock x:Name="InfoText"  Foreground="Gray" FontSize="14"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <TextBlock Text="Кількість частин:" Margin="0,0,0,4" FontSize="18"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="PartsSlider" Minimum="2" Maximum="8" Value="2"
                                Width="280" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="PartsSlider_ValueChanged"/>
                        <TextBlock x:Name="PartsLabel" Margin="10,0"
                                   VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Назва"  FontSize="11" Foreground="Gray"/>
                    <TextBlock Grid.Column="2" Text="Годин"  FontSize="11" Foreground="Gray"/>
                </Grid>

                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                    <ItemsControl x:Name="SubTasksList">  <!-- ← Має бути SubTasksList -->
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Index, StringFormat={}{0}.}"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Margin="0,0,6,0"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="13" Padding="4,2"/>
                                    <TextBox Grid.Column="2"
                                             Text="{Binding Hours, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="13" Padding="4,2"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Скасувати" Width="115" Margin="0,0,10,0"
                            Style="{StaticResource OutlineButton}"
                            Click="Cancel_Click" FontSize="18"/>
                    <Button Content="Розбити" Width="115"
                            Style="{StaticResource PurpleButton}"
                            Click="Confirm_Click" FontSize="18"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>