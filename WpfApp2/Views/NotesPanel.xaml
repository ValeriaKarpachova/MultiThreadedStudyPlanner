<UserControl x:Class="WpfApp2.Views.NotesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Images/notes.png"
                       Width="20" Height="20" Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Нотатки"
                            FontWeight="SemiBold"
                           Foreground="#534AB7" VerticalAlignment="Center"/>
            </StackPanel>
            <Button HorizontalAlignment="Right"
                    Content="+ Нова нотатка" FontSize="11"
                    Click="AddNote_Click" Padding="8,4" Foreground="White">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background"      Value="#534AB7"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor"          Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#6C5FC7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="NotesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Color, Converter={StaticResource StringToBrush}}"
                                CornerRadius="6" Margin="0,0,3,6" Padding="6,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         FontSize="11" MinHeight="50" MaxHeight="130"
                                         BorderThickness="0" Background="Transparent"
                                         TextChanged="NoteText_Changed"
                                         VerticalAlignment="Stretch" Margin="0,0,4,0"/>

                                <StackPanel Grid.Column="1" Orientation="Vertical"
                                            VerticalAlignment="Top" HorizontalAlignment="Center">
                                    <Button Content="✕" Foreground="#999"
                                            Width="14" Height="14" Margin="0,5,0,0"
                                            FontSize="8" Padding="0"
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Hand" Click="DeleteNote_Click"/>
                                    <Button Tag="#D9D8E8" Background="#D9D8E8"
                                            Width="14" Height="14" Margin="0,1"
                                            BorderThickness="1" BorderBrush="#D9D8E8"
                                            Padding="0" Click="Color_Click" Cursor="Hand"/>
                                    <Button Tag="#D2E5DD" Background="#D2E5DD"
                                            Width="14" Height="14" Margin="0,1"
                                            BorderThickness="1" BorderBrush="#D2E5DD"
                                            Padding="0" Click="Color_Click" Cursor="Hand"/>
                                    <Button Tag="#EFD8D6" Background="#EFD8D6"
                                            Width="14" Height="14" Margin="0,1"
                                            BorderThickness="1" BorderBrush="#EFD8D6"
                                            Padding="0" Click="Color_Click" Cursor="Hand"/>
                                    <Button Tag="#CDDCF3" Background="#CDDCF3"
                                            Width="14" Height="14" Margin="0,1"
                                            BorderThickness="1" BorderBrush="#CDDCF3"
                                            Padding="0" Click="Color_Click" Cursor="Hand"/>
                                    <Button Tag="#F3E2CD" Background="#F3E2CD"
                                            Width="14" Height="14" Margin="0,1"
                                            BorderThickness="1" BorderBrush="#F3E2CD"
                                            Padding="0" Click="Color_Click" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
