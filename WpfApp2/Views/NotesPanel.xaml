<UserControl x:Class="WpfApp2.Views.NotesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="📝 Нотатки" FontSize="11" Foreground="Gray"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Button Content="+" Width="22" Height="22" FontSize="14"
                    Padding="0" Click="AddNote_Click" ToolTip="Нова нотатка"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="NotesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Color,
                                    Converter={StaticResource StringToBrush}}"
                                CornerRadius="6" Margin="0,0,0,5" Padding="5">
                            <StackPanel>
                                <!-- Цветовые кнопки + удалить -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right" Margin="0,0,0,3">
                                    <Button Tag="#FFFDE7" Background="#FFFDE7"
                                            Width="14" Height="14" Margin="1"
                                            BorderThickness="1" Padding="0"
                                            Click="Color_Click"/>
                                    <Button Tag="#E8F5E9" Background="#E8F5E9"
                                            Width="14" Height="14" Margin="1"
                                            BorderThickness="1" Padding="0"
                                            Click="Color_Click"/>
                                    <Button Tag="#E3F2FD" Background="#E3F2FD"
                                            Width="14" Height="14" Margin="1"
                                            BorderThickness="1" Padding="0"
                                            Click="Color_Click"/>
                                    <Button Tag="#FCE4EC" Background="#FCE4EC"
                                            Width="14" Height="14" Margin="1"
                                            BorderThickness="1" Padding="0"
                                            Click="Color_Click"/>
                                    <Button Tag="#EDE7F6" Background="#EDE7F6"
                                            Width="14" Height="14" Margin="1"
                                            BorderThickness="1" Padding="0"
                                            Click="Color_Click"/>
                                    <Button Content="✕" Foreground="Gray"
                                            Width="16" Height="16" Margin="3,1,0,1"
                                            FontSize="9" Padding="0"
                                            Background="Transparent" BorderThickness="0"
                                            Click="DeleteNote_Click"/>
                                </StackPanel>
                                <TextBox Text="{Binding Content,
                                             UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         FontSize="11" MinHeight="40" MaxHeight="120"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         TextChanged="NoteText_Changed"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>