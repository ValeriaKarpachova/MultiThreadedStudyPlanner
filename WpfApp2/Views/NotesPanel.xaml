<UserControl x:Class="WpfApp2.Views.NotesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>

        <!-- Header: icon + label + add button -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                    Margin="0,0,0,6" VerticalAlignment="Center">
            <Image Source="/Images/notes.png"
                   Width="22" Height="22"
                   Margin="0,0,7,0"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Нотатки"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="#534AB7"
                       VerticalAlignment="Center"/>
            <Button Content="+ Нова"
                    FontSize="12"
                    Click="AddNote_Click"
                    Margin="10,0,0,0"
                    Padding="10,5"
                    Foreground="White">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#534AB7"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="7">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#6C5FC7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="NotesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Color,
                                    Converter={StaticResource StringToBrush}}"
                                CornerRadius="6" Margin="0,0,4,6" Padding="6,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Note text -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Right column: color swatches + delete -->
                                    <ColumnDefinition Width="22"/>
                                </Grid.ColumnDefinitions>

                                <!-- Note text -->
                                <TextBox Grid.Column="0"
                                         Text="{Binding Content,
                                             UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         FontSize="11"
                                         MinHeight="50" MaxHeight="130"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         TextChanged="NoteText_Changed"
                                         VerticalAlignment="Stretch"
                                         Margin="0,0,4,0"/>

                                <!-- Vertical color swatches + delete -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Vertical"
                                            VerticalAlignment="Top"
                                            HorizontalAlignment="Center">
                                    <Button Tag="#FFFDE7" Background="#FFFDE7"
                                            Width="16" Height="16" Margin="0,1"
                                            BorderThickness="1" BorderBrush="#BBB"
                                            Padding="0" Click="Color_Click"
                                            Cursor="Hand"/>
                                    <Button Tag="#E8F5E9" Background="#E8F5E9"
                                            Width="16" Height="16" Margin="0,1"
                                            BorderThickness="1" BorderBrush="#BBB"
                                            Padding="0" Click="Color_Click"
                                            Cursor="Hand"/>
                                    <Button Tag="#E3F2FD" Background="#E3F2FD"
                                            Width="16" Height="16" Margin="0,1"
                                            BorderThickness="1" BorderBrush="#BBB"
                                            Padding="0" Click="Color_Click"
                                            Cursor="Hand"/>
                                    <Button Tag="#FCE4EC" Background="#FCE4EC"
                                            Width="16" Height="16" Margin="0,1"
                                            BorderThickness="1" BorderBrush="#BBB"
                                            Padding="0" Click="Color_Click"
                                            Cursor="Hand"/>
                                    <Button Tag="#EDE7F6" Background="#EDE7F6"
                                            Width="16" Height="16" Margin="0,1"
                                            BorderThickness="1" BorderBrush="#BBB"
                                            Padding="0" Click="Color_Click"
                                            Cursor="Hand"/>
                                    <!-- Delete -->
                                    <Button Content="✕"
                                            Foreground="#999"
                                            Width="16" Height="16" Margin="0,5,0,0"
                                            FontSize="9" Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="DeleteNote_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
