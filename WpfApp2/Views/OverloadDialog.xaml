<Window x:Class="WpfApp2.Views.OverloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Перевантаження розкладу"
        Height="350" Width="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20">

        <TextBlock Text="⚠️ День перевантажений"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <TextBlock x:Name="HoursText"
                   FontSize="14"
                   Margin="0,0,0,20"/>

        <Grid x:Name="CardsGrid" Height="180">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Перенести -->
            <Border Grid.Column="0"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,0,8,0"
                    Padding="12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Перенести завдання"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>

                    <!-- СКРОЛ -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="MoveText"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="Gray"
                                   Text="Завдання з найнижчим пріоритетом буде перенесено на завтра."/>
                    </ScrollViewer>

                    <!-- КНОПКА ВНИЗУ -->
                    <Button Grid.Row="2"
                            Content="Перенести"
                            Margin="0,10,0,0"
                            Click="Move_Click"/>
                </Grid>
            </Border>

            <!-- Розбити -->
            <Border Grid.Column="1"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="8,0"
                    Padding="12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Розбити завдання"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Оберіть завдання для поділу на частини:"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="Gray"
                                   Margin="0,0,0,6"/>

                        <ComboBox x:Name="SplitTaskCombo"
                                  DisplayMemberPath="Name"
                                  FontSize="12"/>
                    </StackPanel>

                    <Button Grid.Row="2"
                            Content="Розбити"
                            Margin="0,10,0,0"
                            Click="Split_Click"/>
                </Grid>
            </Border>

            <!-- Ігнорувати -->
            <Border Grid.Column="2"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="8,0,0,0"
                    Padding="12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Ігнорувати"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="Залишити все без змін. За потреби завдання можна перенести вручну."
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="Gray"/>
                    </ScrollViewer>

                    <Button Grid.Row="2"
                            Content="Ігнорувати"
                            Margin="0,10,0,0"
                            Click="Ignore_Click"/>
                </Grid>
            </Border>
        </Grid>
    </StackPanel>
</Window>