<Window x:Class="WpfApp2.Views.OverloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Перегрузка расписания"
        Height="300" Width="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20">

        <TextBlock Text="⚠️ День перегружен"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <TextBlock x:Name="HoursText"
                   FontSize="14"
                   Margin="0,0,0,20"/>

        <Grid x:Name="CardsGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Перенести -->
            <Border Grid.Column="0" BorderBrush="Gray"
            BorderThickness="1" CornerRadius="6"
            Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Перенести завдання"
                       FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="MoveText" TextWrapping="Wrap"
                       FontSize="12" Foreground="Gray"><Run Text="Завдання з найнижч"/><Run Text="ім пріорітетом буде перенесено на завтра"/><Run Text="."/><LineBreak/></TextBlock>
                    <Button Content="Перенести" Click="Move_Click"/>
                </StackPanel>
            </Border>

            <!-- Розбити завдання (завжди видима, з вибором) -->
            <Border Grid.Column="1" BorderBrush="Gray"
            BorderThickness="1" CornerRadius="6"
            Margin="8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Розбити завдання"
                       FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="Виберіть завдання для розбиття на частини:"
                       TextWrapping="Wrap" FontSize="12"
                       Foreground="Gray" Margin="0,0,0,6"/>
                    <ComboBox x:Name="SplitTaskCombo"
                      Margin="0,0,0,10"
                      DisplayMemberPath="Name"
                      FontSize="12"/>
                    <Button Content="Розбити" Click="Split_Click"/>
                </StackPanel>
            </Border>

            <!-- Ігнорувати -->
            <Border Grid.Column="2" BorderBrush="Gray"
            BorderThickness="1" CornerRadius="6"
            Margin="8,0,0,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Ігнорувати"
                       FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                       Foreground="Gray" Margin="0,0,0,12"
                       Text="Залишити все як є. Завдання можна перенести вручну."/>
                    <Button Content="Ігнорувати" Click="Ignore_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</Window>