<Window x:Class="WpfApp2.Views.OverloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Перевантаження розкладу"
        Height="400" Width="680"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background"      Value="#534AB7"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6C5FC7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3C3489"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" 
            CornerRadius="12" 
            BorderThickness="0"
            >
        
        <Border BorderBrush="#E0DEFF" 
                BorderThickness="1" 
                CornerRadius="12"
                Background="White">
            
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <Border Grid.Row="0" 
                        Background="#534AB7" 
                        CornerRadius="8,8,0,0" 
                        Margin="-20,-20,-20,0"
                        Height="40"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <TextBlock Text="Перевантаження розкладу" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                        <Button Content="✕" 
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            Click="Close_Click"/>
                    </Grid>
                </Border>

                <!-- Контент -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,20,0,10" VerticalAlignment="Center">
                    <Image Source="/Images/warning.png"
                           Width="40" Height="40"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="День перевантажений"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Row="2" x:Name="HoursText"
                           FontSize="14"
                           Margin="0,0,0,20"/>

                <Grid Grid.Row="3" x:Name="CardsGrid" Height="190">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Перенести -->
                    <Border Grid.Column="0"
                            BorderBrush="#D0CBFF" BorderThickness="1"
                            CornerRadius="8" Margin="0,0,8,0" Padding="12"
                            Background="#FAFAFE">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Перенести завдання"
                                       FontWeight="Bold" 
                                       Foreground="#534AB7"
                                       Margin="0,0,0,6"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="MoveText"
                                           TextWrapping="Wrap" FontSize="14"
                                           Foreground="Gray"/>
                            </ScrollViewer>
                            <Button Grid.Row="2" Content="Перенести"
                                    FontSize="18"
                                    Style="{StaticResource ActionButton}"
                                    Click="Move_Click"/>
                        </Grid>
                    </Border>

                    <!-- Розбити -->
                    <Border Grid.Column="1"
                            BorderBrush="#D0CBFF" BorderThickness="1"
                            CornerRadius="8" Margin="8,0" Padding="12"
                            Background="#FAFAFE">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Розбити завдання"
                                       FontWeight="Bold" 
                                       Foreground="#534AB7"
                                       Margin="0,0,0,6"/>
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="Оберіть завдання для поділу на частини:"
                                           TextWrapping="Wrap" FontSize="14"
                                           Foreground="Gray" Margin="0,0,0,6"/>
                                <ComboBox x:Name="SplitTaskCombo"
                                          DisplayMemberPath="Name" FontSize="14"/>
                            </StackPanel>
                            <Button Grid.Row="2" Content="Розбити"
                                    FontSize="18"
                                    Style="{StaticResource ActionButton}"
                                    Click="Split_Click"/>
                        </Grid>
                    </Border>

                    <!-- Ігнорувати -->
                    <Border Grid.Column="2"
                            BorderBrush="#D0CBFF" BorderThickness="1"
                            CornerRadius="8" Margin="8,0,0,0" Padding="12"
                            Background="#FAFAFE">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Ігнорувати"
                                       FontWeight="Bold" 
                                       Foreground="#534AB7"
                                       Margin="0,0,0,6"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="Залишити все без змін. За потреби завдання можна перенести вручну."
                                           TextWrapping="Wrap" FontSize="14"
                                           Foreground="Gray"/>
                            </ScrollViewer>
                            <Button Grid.Row="2" Content="Ігнорувати"
                                    Style="{StaticResource ActionButton}"
                                    Click="Ignore_Click" FontSize="18"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>