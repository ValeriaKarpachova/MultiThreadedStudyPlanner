<Window x:Class="WpfApp2.Views.OverloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Перегрузка расписания"
        Height="300" Width="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20">

        <TextBlock Text="⚠️ День перегружен"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <TextBlock x:Name="HoursText"
                   FontSize="14"
                   Margin="0,0,0,20"/>

        <Grid x:Name="CardsGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="SplitColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Перенести -->
            <Border Grid.Column="0"
                    BorderBrush="Gray" BorderThickness="1"
                    CornerRadius="6" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Перенести задания"
                               FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="MoveText"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="Gray" Margin="0,0,0,12"/>
                    <Button Content="Перенести" Click="Move_Click"/>
                </StackPanel>
            </Border>

            <!-- Игнорировать -->
            <Border Grid.Column="1"
                    BorderBrush="Gray" BorderThickness="1"
                    CornerRadius="6" Margin="8,0,0,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Игнорировать"
                               FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="Gray" Margin="0,0,0,12"
                               Text="Оставить всё как есть. Можно перенести задания вручную позже."/>
                    <Button Content="Игнорировать" Click="Ignore_Click"/>
                </StackPanel>
            </Border>

            <!-- Разбить задание (видна только если есть задание > 6ч) -->
            <Border x:Name="SplitCard"
                    Grid.Column="2"
                    BorderBrush="Gray" BorderThickness="1"
                    CornerRadius="6" Margin="8,0,0,0" Padding="12"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Разбить задание"
                               FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="SplitText"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="Gray" Margin="0,0,0,12"/>
                    <Button Content="Разбить" Click="Split_Click"/>
                </StackPanel>
            </Border>

        </Grid>
    </StackPanel>
</Window>