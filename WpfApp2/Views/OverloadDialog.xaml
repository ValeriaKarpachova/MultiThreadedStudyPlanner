<Window x:Class="WpfApp2.Views.OverloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Перевантаження розкладу"
        Height="370" Width="660"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background"      Value="#534AB7"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6C5FC7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3C3489"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">

        <!-- Header with PNG image instead of emoji -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
            <Image Source="/Images/warning.png"
                   Width="28" Height="28"
                   Margin="0,0,10,0"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="День перевантажений"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock x:Name="HoursText"
                   FontSize="14"
                   Margin="0,0,0,20"/>

        <Grid x:Name="CardsGrid" Height="190">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Перенести -->
            <Border Grid.Column="0"
                    BorderBrush="#D0CBFF" BorderThickness="1"
                    CornerRadius="8" Margin="0,0,8,0" Padding="12"
                    Background="#FAFAFE">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Перенести завдання"
                               FontWeight="Bold" FontSize="14"
                               Foreground="#534AB7"
                               Margin="0,0,0,6"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="MoveText"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="Gray"
                                   Text="Завдання з найнижчим пріоритетом буде перенесено на завтра."/>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="Перенести"
                            Margin="0,10,0,0"
                            Style="{StaticResource ActionButton}"/>
                </Grid>
            </Border>

            <!-- Розбити -->
            <Border Grid.Column="1"
                    BorderBrush="#D0CBFF" BorderThickness="1"
                    CornerRadius="8" Margin="8,0" Padding="12"
                    Background="#FAFAFE">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Розбити завдання"
                               FontWeight="Bold" FontSize="14"
                               Foreground="#534AB7"
                               Margin="0,0,0,6"/>
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Оберіть завдання для поділу на частини:"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="Gray" Margin="0,0,0,6"/>
                        <ComboBox x:Name="SplitTaskCombo"
                                  DisplayMemberPath="Name" FontSize="12"/>
                    </StackPanel>
                    <Button Grid.Row="2" Content="Розбити"
                            Margin="0,10,0,0"
                            Style="{StaticResource ActionButton}"
                            Click="Split_Click"/>
                </Grid>
            </Border>

            <!-- Ігнорувати -->
            <Border Grid.Column="2"
                    BorderBrush="#D0CBFF" BorderThickness="1"
                    CornerRadius="8" Margin="8,0,0,0" Padding="12"
                    Background="#FAFAFE">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Ігнорувати"
                               FontWeight="Bold" FontSize="14"
                               Foreground="#534AB7"
                               Margin="0,0,0,6"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="Залишити все без змін. За потреби завдання можна перенести вручну."
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="Gray"/>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="Ігнорувати"
                            Margin="0,10,0,0"
                            Style="{StaticResource ActionButton}"
                            Click="Ignore_Click"/>
                </Grid>
            </Border>
        </Grid>
    </StackPanel>
</Window>
