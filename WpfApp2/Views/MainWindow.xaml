<Window x:Class="WpfApp2.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="600" Width="1000"
        WindowState="Maximized" WindowStyle="SingleBorderWindow"
        xmlns:views="clr-namespace:WpfApp2.Views"
        Icon="/Images/app_logo2.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0"
                Background="#EEF0F8"
                BorderBrush="#D8DCF0"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Заголовок -->
                <Border DockPanel.Dock="Top" Background="#534AB7" Padding="16,14">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/app_logo.png" Width="28" Height="28"
                               Margin="0,0,10,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Student Planner" FontSize="18" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Навігаційні кнопки -->
                <StackPanel DockPanel.Dock="Top" Margin="6,8,6,0">

                    <Button x:Name="BtnHome" Tag="active"
                            Style="{StaticResource NavButton}" Padding="14,8" Click="Home_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/home.png" Width="22" Height="22"
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Головна" VerticalAlignment="Center" FontSize="16" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnToday"
                            Style="{StaticResource NavButton}" Padding="14,8" Click="Today_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/today.png" Width="22" Height="22"
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Сьогодні" VerticalAlignment="Center" FontSize="16"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnCompleted"
                            Style="{StaticResource NavButton}" Padding="14,8" Click="Completed_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/done.png" Width="22" Height="22"
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Виконані" VerticalAlignment="Center" FontSize="16"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSubjects"
                            Style="{StaticResource NavButton}" Padding="14,8" Click="Subjects_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/subjects.png" Width="22" Height="22"
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Предмети" VerticalAlignment="Center" FontSize="16"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnCalendar"
                            Style="{StaticResource NavButton}" Padding="14,8" Click="Calendar_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/calendar.png" Width="22" Height="22"
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Календар" VerticalAlignment="Center" FontSize="16"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnStatistics"
                            Style="{StaticResource NavButton}" Padding="14,8" Click="Statistics_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/stats.png" Width="22" Height="22"
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Статистика" VerticalAlignment="Center" FontSize="16"/>
                        </StackPanel>
                    </Button>

                    <Separator Margin="0,6"/>

                    <!-- Pomodoro label: centered, Ukrainian only, with icon -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,2,0,4">
                    </StackPanel>
                    <views:PomodoroWidget Margin="0,0,0,6"/>

                    <Separator Margin="0,4"/>

                    <!-- Mini calendar label + stretched widget -->
                    <StackPanel Orientation="Horizontal" Margin="4,4,0,2"/>
                    <views:MiniCalendarPanel HorizontalAlignment="Stretch" Margin="0,0,0,4"/>

                    <Separator Margin="0,4"/>
                </StackPanel>

                <!-- Нотатки -->
                <Border Margin="6,4,6,8">
                    <views:NotesPanel/>
                </Border>

            </DockPanel>
        </Border>

        <!-- RIGHT SIDE -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F4F3FF"
                    BorderBrush="#E0DEFF" BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="22" Background="#534AB7"
                                CornerRadius="2" Margin="0,0,10,0"/>
                        <TextBlock x:Name="PageTitle" Text="Головна"
                                   FontSize="17" FontWeight="SemiBold"
                                   Foreground="#2D2561" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="AddTask_Click" Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/add.png" Width="22" Height="22"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Додати завдання" VerticalAlignment="Center" FontSize="16" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" x:Name="MainContent" Margin="0"/>
        </Grid>
    </Grid>
</Window>
