<Window x:Class="WpfApp2.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Планувальник завдань"
        Height="600" Width="1000">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3.8*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Планувальник"
                   FontSize="18"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="10"/>

        <Button Grid.Row="0" Grid.Column="1"
                Width="35" Height="35"
                HorizontalAlignment="Right"
                Margin="5"
                Click="AddTask_Click"
                Padding="0">

            <TextBlock Text="+"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Button>

        <!-- LEFT PANEL -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="10">

            <Button Content="Головна"
                    Style="{StaticResource FlatButton}"
                    Margin="0,5"
                    Click="Home_Click"/>

            <Button Content="Сьогодні"
                    Style="{StaticResource FlatButton}"
                    Margin="0,5"
                    Click="Today_Click"/>

            <Button Content="Виконані"
                    Style="{StaticResource FlatButton}"
                    Margin="0,5"
                    Click="Completed_Click"/>

            <Button Content="Календар"
                    Style="{StaticResource FlatButton}"
                    Margin="0,5"
                    Click="Calendar_Click"/>

            <Button Content="Статистика"
                    Style="{StaticResource FlatButton}"
                    Margin="0,5"
                    Click="Statistics_Click"/>

        </StackPanel>

        <!-- MAIN CONTENT AREA -->
        <ContentControl Grid.Row="1"
                        Grid.Column="1"
                        x:Name="MainContent"
                        Margin="5"/>

    </Grid>
</Window>