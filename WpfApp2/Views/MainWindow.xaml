<Window x:Class="WpfApp2.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Планувальник завдань"
        Height="600" Width="1000"
        WindowState="Maximized" WindowStyle="SingleBorderWindow"
        xmlns:views="clr-namespace:WpfApp2.Views">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0"
                Background="#EEF0F8"
                BorderBrush="#D8DCF0"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Заголовок -->
                <Border DockPanel.Dock="Top"
                        Background="#534AB7"
                        Padding="16,14">
                    <StackPanel Orientation="Horizontal">
                        <!-- Місце для PNG логотипу -->
                        <Image Source="/Images/app_logo.png"
                               Width="28" Height="28"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Student Planner"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Навігаційні кнопки — розтягнуті на всю ширину -->
                <StackPanel DockPanel.Dock="Top" Margin="6,8,6,0">

                    <Button x:Name="BtnHome" Tag="active"
                            Style="{StaticResource NavButton}"
                            HorizontalContentAlignment="Left"
                            Padding="14,11"
                            Click="Home_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/home.png" Width="18" Height="18"
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Головна" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnToday"
                            Style="{StaticResource NavButton}"
                            HorizontalContentAlignment="Left"
                            Padding="14,11"
                            Click="Today_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/today.png" Width="19" Height="18"
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Сьогодні" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnCompleted"
                            Style="{StaticResource NavButton}"
                            HorizontalContentAlignment="Left"
                            Padding="14,11"
                            Click="Completed_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/done.png" Width="18" Height="18"
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Виконані" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSubjects"
                            Style="{StaticResource NavButton}"
                            HorizontalContentAlignment="Left"
                            Padding="14,11"
                            Click="Subjects_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/subjects.png" Width="18" Height="18"
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Предмети" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnCalendar"
                            Style="{StaticResource NavButton}"
                            HorizontalContentAlignment="Left"
                            Padding="14,11"
                            Click="Calendar_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/calendar.png" Width="18" Height="18"
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Календар" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnStatistics"
                            Style="{StaticResource NavButton}"
                            HorizontalContentAlignment="Left"
                            Padding="14,11"
                            Click="Statistics_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/stats.png" Width="18" Height="18"
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Статистика" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </Button>

                    <Separator Margin="0,6"/>
                    <views:PomodoroWidget Margin="0,0,0,6"/>
                    <Separator Margin="0,4"/>

                    <!-- Міні-календар -->
                    <views:MiniCalendarPanel Margin="0,4,0,6"/>
                    <Separator Margin="0,4"/>
                </StackPanel>

                <!-- Нотатки -->
                <Border Margin="6,4,6,8">
                    <views:NotesPanel/>
                </Border>
            </DockPanel>
        </Border>

        <!-- RIGHT SIDE -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="#F4F3FF"
                    BorderBrush="#E0DEFF"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="4" Height="22"
                                Background="#534AB7"
                                CornerRadius="2"
                                Margin="0,0,10,0"/>
                        <TextBlock x:Name="PageTitle"
                                   Text="Головна"
                                   FontSize="17" FontWeight="SemiBold"
                                   Foreground="#2D2561"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="AddTask_Click"
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/add.png" Width="19" Height="21"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Додати завдання"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" x:Name="MainContent" Margin="0"/>
        </Grid>
    </Grid>
</Window>
