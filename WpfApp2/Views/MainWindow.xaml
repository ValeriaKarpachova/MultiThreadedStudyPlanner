<Window x:Class="WpfApp2.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Планувальник завдань"
        Height="600" Width="1000"
        WindowState="Maximized" WindowStyle="SingleBorderWindow"
        xmlns:views="clr-namespace:WpfApp2.Views">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3.8*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Планувальник"
                   FontSize="18"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="10"/>

        <Button Grid.Row="0" Grid.Column="1"
                Width="35" Height="35"
                HorizontalAlignment="Right"
                Margin="5"
                Click="AddTask_Click"
                Padding="0">

            <TextBlock Text="+"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Button>

        <!-- LEFT PANEL -->
        <DockPanel Grid.Row="1" Grid.Column="0" Margin="6,4">

    <!-- Навігаційні кнопки -->
            <StackPanel DockPanel.Dock="Top">
                <Button x:Name="BtnHome"       Content="🏠  Home"
            Style="{StaticResource NavButton}" Click="Home_Click"/>
                <Button x:Name="BtnToday"      Content="📅  Today"
            Style="{StaticResource NavButton}" Click="Today_Click"/>
                <Button x:Name="BtnCompleted"  Content="✅  Виконані"
            Style="{StaticResource NavButton}" Click="Completed_Click"/>
                <Button x:Name="BtnSubjects"   Content="📚  Предмети"
            Style="{StaticResource NavButton}" Click="Subjects_Click"/>
                <Button x:Name="BtnCalendar"   Content="🗓  Календар"
            Style="{StaticResource NavButton}" Click="Calendar_Click"/>
                <Button x:Name="BtnStatistics" Content="📊  Статистика"
            Style="{StaticResource NavButton}" Click="Statistics_Click"/>
                <Button x:Name="BtnTheme"      Content="🌙  Темна тема"
            Style="{StaticResource NavButton}" Click="Theme_Click"/>
                <Separator Margin="0,6"/>
                <!-- Помідор -->
        <views:PomodoroWidget Margin="0,0,0,6"/>
        <Separator Margin="0,4"/>

        <!-- Міні-календар -->
        <views:MiniCalendarPanel Margin="0,4,0,6"/>
        <Separator Margin="0,4"/>
    </StackPanel>

    <!-- Нотатки заповнюють залишок -->
    <views:NotesPanel/>

</DockPanel>

        <!-- MAIN CONTENT AREA -->
        <ContentControl Grid.Row="1"
                        Grid.Column="1"
                        x:Name="MainContent"
                        Margin="5"/>

    </Grid>
</Window>