<Window x:Class="WpfApp2.Views.EditPartsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редагування частин" Height="560" Width="650"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="PurpleButton" TargetType="Button">
            <Setter Property="Background"      Value="#534AB7"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6C5FC7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3C3489"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#534AB7"/>
            <Setter Property="BorderBrush"     Value="#534AB7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0EEFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ImageButtonStyle2" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Width"           Value="30"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0EEFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" 
            CornerRadius="12" 
            BorderThickness="0">
        
        <Border BorderBrush="#E0DEFF" 
                BorderThickness="1" 
                CornerRadius="12"
                Background="White">
            
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" 
                        Background="#534AB7" 
                        CornerRadius="8,8,0,0" 
                        Margin="-16,-16,-16,0"
                        Height="40"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <TextBlock Text="Редагування частин" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                        <Button Content="✕" 
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            Click="Close_Click"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,16,0,12">
                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="InfoText" Foreground="Gray" FontSize="14"/>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Назва"
                               FontSize="13" FontWeight="SemiBold" Foreground="#534AB7"/>
                    <TextBlock Grid.Column="2" Text="Годин"
                               FontSize="13" FontWeight="SemiBold" Foreground="#534AB7"/>
                    <TextBlock Grid.Column="3" Text="Дедлайн"
                               FontSize="13" FontWeight="SemiBold" Foreground="#534AB7"/>
                    <TextBlock Grid.Column="4" Text="Дії"
                               FontSize="13" FontWeight="SemiBold" Foreground="#534AB7"/>
                </Grid>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                              Margin="0,0,0,12">
                    <ItemsControl x:Name="PartsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Index, StringFormat={}{0}.}"
                                               VerticalAlignment="Center" FontSize="12"/>

                                    <TextBox Grid.Column="1" Margin="0,0,6,0" FontSize="13" Padding="4,2"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBox Grid.Column="2" Margin="0,0,6,0" FontSize="13" Padding="4,2"
                                             Text="{Binding Hours, UpdateSourceTrigger=PropertyChanged}"/>

                                    <DatePicker Grid.Column="3" Margin="0,0,6,0" FontSize="13"
                                                SelectedDate="{Binding Deadline}"/>

                                    <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource ImageButtonStyle2}" Margin="2"
                                                ToolTip="Видалити"
                                                Click="DeletePart_Click"
                                                Tag="{Binding}">
                                            <Image Source="/Images/delete.png"
                                                   Width="20" Height="20" Stretch="Uniform"/>
                                        </Button>

                                        <Button Style="{StaticResource ImageButtonStyle2}" Margin="2"
                                                ToolTip="Розбити частину"
                                                Click="SplitPart_Click"
                                                Visibility="{Binding IsSplit, Converter={StaticResource InverseBoolToVisibility}}"
                                                Tag="{Binding}">
                                            <Image Source="/Images/split.png"
                                                   Width="20" Height="20" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="4" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Зберегти" Width="115" Margin="0,0,10,0"
                            Style="{StaticResource PurpleButton}"
                            Click="Save_Click" FontSize="18" />
                    <Button Content="Скасувати" Width="115"
                            Style="{StaticResource OutlineButton}"
                            Click="Cancel_Click"
                            FontSize="18" />
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>