<Window x:Class="WpfApp2.Views.EditPartsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редагування частин" Height="520" Width="620"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold"/>
            <TextBlock x:Name="InfoText" Foreground="Gray" FontSize="12"/>
        </StackPanel>

        <!-- Заголовки колонок -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="105"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Назва"       FontSize="11" Foreground="Gray"/>
            <TextBlock Grid.Column="2" Text="Годин"       FontSize="11" Foreground="Gray"/>
            <TextBlock Grid.Column="3" Text="Дедлайн"    FontSize="11" Foreground="Gray"/>
            <TextBlock Grid.Column="4" Text="Дії"         FontSize="11" Foreground="Gray"/>
        </Grid>

        <!-- Список частин -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Margin="0,0,0,12">
            <ItemsControl x:Name="PartsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Index, StringFormat={}{0}.}"
                                       VerticalAlignment="Center" FontSize="12"/>

                            <TextBox Grid.Column="1" Margin="0,0,6,0"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBox Grid.Column="2" Margin="0,0,6,0"
                                     Text="{Binding Hours, UpdateSourceTrigger=PropertyChanged}"/>

                            <DatePicker Grid.Column="3" Margin="0,0,6,0"
                                        SelectedDate="{Binding Deadline}"/>

                            <!-- Кнопки дій для кожної частини -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource ImageButtonStyle}" Margin="2"
                                        Width="30" Height="30"
                                        Cursor="Hand"
                                        ToolTip="Видалити"
                                        Click="DeletePart_Click"
                                        Tag="{Binding}">
                                    <Image Source="/Images/delete.png" 
                                       Width="25" Height="25"
                                       Stretch="Uniform"/>
                                </Button>

                                <Button Style="{StaticResource ImageButtonStyle}" Margin="2"
                                    Width="30" Height="30"
                                    Cursor="Hand"
                                    ToolTip="Розбити частину"
                                    Click="SplitPart_Click"
                                    Visibility="{Binding IsSplit, Converter={StaticResource InverseBoolToVisibility}}"
                                    Tag="{Binding}">            
                                    <Image Source="/Images/split.png" 
                                        Width="25" Height="25"
                                        Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Кнопки збереження -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Зберегти" Width="100" Margin="0,0,10,0"
                    Click="Save_Click"/>
            <Button Content="Скасувати" Width="100"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>