<UserControl x:Class="WpfApp2.Views.StatisticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">

            <TextBlock Text="📊 Статистика" FontSize="22"
                       FontWeight="Bold" Margin="0,0,0,14"/>

            <!-- Картки KPI -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,20">
                <Border x:Name="CardTotal"     Style="{StaticResource KpiCard}"/>
                <Border x:Name="CardDone"      Style="{StaticResource KpiCard}"/>
                <Border x:Name="CardOverdue"   Style="{StaticResource KpiCard}"/>
                <Border x:Name="CardProductivity" Style="{StaticResource KpiCard}"/>
            </UniformGrid>

            <!-- Рядок: стовпчаста + кругова -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Задачі за типом" FontWeight="SemiBold"
                               FontSize="14" Margin="0,0,0,6"/>
                    <lvc:CartesianChart x:Name="ByTypeChart" Height="220"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Статус задач" FontWeight="SemiBold"
                               FontSize="14" Margin="0,0,0,6"/>
                    <lvc:PieChart x:Name="StatusPie" Height="220"/>
                </StackPanel>
            </Grid>

            <!-- Лінійний: прогрес по дням -->
            <TextBlock Text="Навантаження по тижням (год)" FontWeight="SemiBold"
                       FontSize="14" Margin="0,0,0,6"/>
            <lvc:CartesianChart x:Name="WeekLoadChart" Height="200" Margin="0,0,0,20"/>

            <TextBlock Text="Топ задач за обсягом (год)" FontWeight="SemiBold"
           FontSize="14" Margin="0,0,0,6"/>
            <lvc:CartesianChart x:Name="TopTasksChart" Height="220" Margin="0,0,0,20"/>

            <TextBlock Text="Статистика по предметах" FontWeight="SemiBold"
           FontSize="14" Margin="0,0,0,6"/>
            <lvc:CartesianChart x:Name="SubjectChart" Height="260"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>