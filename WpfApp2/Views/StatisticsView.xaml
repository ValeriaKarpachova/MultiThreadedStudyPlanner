<UserControl x:Class="WpfApp2.Views.StatisticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <TextBlock Text="📊 Статистика продуктивності"
                       FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

            <!-- KPI рядок 1 -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,12">
                <Border x:Name="CardTotal"        Style="{StaticResource KpiCard}"/>
                <Border x:Name="CardDone"         Style="{StaticResource KpiCard}"/>
                <Border x:Name="CardOverdue"      Style="{StaticResource KpiCard}"/>
                <Border x:Name="CardProductivity" Style="{StaticResource KpiCard}"/>
            </UniformGrid>

            <!-- KPI рядок 2 -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,20">
                <Border x:Name="CardTotalHours"  Style="{StaticResource KpiCard}"/>
                <Border x:Name="CardDoneHours"   Style="{StaticResource KpiCard}"/>
                <Border x:Name="CardAvgProgress" Style="{StaticResource KpiCard}"/>
                <Border x:Name="CardTodayHours"  Style="{StaticResource KpiCard}"/>
            </UniformGrid>

            <!-- Стовпчаста + кругова -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Задачі за типом" FontWeight="SemiBold"
                                Margin="0,0,0,6"/>
                    <lvc:CartesianChart x:Name="ByTypeChart" Height="260"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Статус задач" FontWeight="SemiBold"
                                Margin="0,0,0,6"/>
                    <lvc:PieChart x:Name="StatusPie" Height="220"/>
                    <ContentControl x:Name="LegendPanel" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Навантаження по тижнях -->
            <TextBlock Text="Навантаження по тижнях (год)"
                       FontWeight="SemiBold"  Margin="0,0,0,6"/>
            <lvc:CartesianChart x:Name="WeekLoadChart" Height="200" Margin="0,0,0,20"/>

            <!-- Топ задач -->
            <TextBlock Text="Топ задач за обсягом (год)"
                       FontWeight="SemiBold"  Margin="0,0,0,4"/>
            <ContentControl x:Name="TopTasksList" Margin="0,0,0,20"/>

            <!-- Дедлайни: 14 днів -->
            <TextBlock Text="Навантаження на найближчі 14 днів (год)"
                       FontWeight="SemiBold"  Margin="0,0,0,6"/>
            <lvc:CartesianChart x:Name="DeadlineChart" Height="180" Margin="0,0,0,20"/>

            <!-- Статистика по предметах -->
            <TextBlock Text="Статистика по предметах"
                       FontWeight="SemiBold"  Margin="0,0,0,6"/>
            <ContentControl x:Name="SubjectAccordion" Margin="0,0,0,16"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
