<UserControl x:Class="WpfApp2.Views.SubjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <DockPanel Margin="14">
        <!-- Заголовок + кнопка -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="📚 Предмети" FontSize="22" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <Button Content="+ Додати предмет" Margin="14,0,0,0"
                    Padding="10,4" Click="AddSubject_Click"/>
        </StackPanel>

        <!-- Список предметів -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SubjectsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" CornerRadius="8"
                                BorderThickness="0,0,0,0"
                                Background="#F8F8FF">
                            <Expander>
                                <Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="6"
                                                Background="{Binding Color,
                                                    Converter={StaticResource StringToBrush}}"
                                                CornerRadius="3" Margin="0,2,8,2"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="🗑"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="6,2" Click="DeleteSubject_Click"/>
                                    </Grid>
                                </Expander.Header>
                                <!-- Задачі предмету -->
                                <ItemsControl x:Name="TasksOfSubject"
                                              ItemsSource="{Binding Tasks}"
                                              Margin="16,4,4,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsChecked}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13"/>
                                                    <TextBlock
                                                        Text="{Binding Deadline,
                                                            StringFormat=Дедлайн: {0:dd.MM.yyyy}}"
                                                        FontSize="11" Foreground="Gray"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding EstimatedHours,
                                                               StringFormat={}{0}ч}"
                                                           FontSize="11" Foreground="Gray"
                                                           Margin="6,0"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="3" Content="✕"
                                                        Foreground="#E2483D"
                                                        Background="Transparent"
                                                        BorderThickness="0" Padding="4,0"
                                                        Click="DeleteTask_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>