<UserControl x:Class="WpfApp2.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataGrid x:Name="TasksGrid"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserResizeRows="False"
              SelectionMode="Single"
              Margin="5"
              HorizontalScrollBarVisibility="Disabled"
              RowDetailsVisibilityMode="Collapsed">

        <DataGrid.Columns>

            <!-- Стрілка для розбитих -->
            <DataGridTemplateColumn Width="60">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <ToggleButton x:Name="ExpanderToggle"
                          Background="Transparent" BorderThickness="0"
                          Cursor="Hand" Padding="8,4"
                          HorizontalAlignment="Stretch"
                          Visibility="{Binding IsSplit, Converter={StaticResource BoolToVisibility}}"
                          Checked="ExpanderToggle_Checked"
                          Unchecked="ExpanderToggle_Unchecked"
                          Tag="{Binding}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">
                                        <Path x:Name="Arrow" Data="M 0 0 L 6 4 L 0 8 Z"
                                              Fill="#666" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Arrow" Property="Fill" Value="#333"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetName="Arrow"
                                                            Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                            To="90" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetName="Arrow"
                                                            Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                            To="0" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Назва -->
            <DataGridTemplateColumn Header="Назва" Width="2*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="4,0"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Опис -->
            <DataGridTemplateColumn Header="Опис" Width="1.5*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Description}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Foreground="Gray" Margin="4,0"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Години: F1 формат -->
            <DataGridTextColumn Header="Години"
                                Binding="{Binding EstimatedHours, StringFormat={}{0:F1} ч.}"
                                Width="0.7*"/>

            <!-- Дедлайн -->
            <DataGridTextColumn Header="Дедлайн"
                                Binding="{Binding Deadline, StringFormat={}{0:dd.MM.yyyy}}"
                                Width="1*"/>

            <!-- Прогрес / Чекбокс -->
            <DataGridTemplateColumn Header="Прогрес" Width="1.5*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel VerticalAlignment="Center" Margin="4,0">
                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="8"
                                         Visibility="{Binding IsSplit, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding Progress, StringFormat={}{0}%, Mode=OneWay}"
                                       FontSize="11" Foreground="Gray"
                                       Visibility="{Binding IsSplit, Converter={StaticResource BoolToVisibility}}"/>
                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                      Visibility="{Binding IsSplit, Converter={StaticResource InverseBoolToVisibility}}"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Дії -->
            <DataGridTemplateColumn Header="Дії" Width="1.2*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Style="{StaticResource ImageButtonStyle}" Margin="2"
                                    Width="40" Height="40" Cursor="Hand"
                                    ToolTip="Редагувати" Click="Edit_Click" Tag="{Binding}">
                                <Image Source="/Images/edit.png" Width="25" Height="25" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource ImageButtonStyle}" Margin="2"
                                    Width="40" Height="40" Cursor="Hand"
                                    ToolTip="Видалити" Click="Delete_Click" Tag="{Binding}">
                                <Image Source="/Images/delete.png" Width="25" Height="25" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource ImageButtonStyle}" Margin="2"
                                    Width="40" Height="40" Cursor="Hand"
                                    ToolTip="Розбити" Click="Split_Click"
                                    Visibility="{Binding IsSplit, Converter={StaticResource InverseBoolToVisibility}}"
                                    Tag="{Binding}">
                                <Image Source="/Images/split.png" Width="25" Height="25" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource ImageButtonStyle}" Margin="2"
                                    Width="40" Height="40" Cursor="Hand"
                                    ToolTip="Редагувати частини" Click="EditParts_Click"
                                    Visibility="{Binding IsSplit, Converter={StaticResource BoolToVisibility}}"
                                    Tag="{Binding}">
                                <Image Source="/Images/arrow.png" Width="25" Height="25" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

        </DataGrid.Columns>

        <!-- Розгортання підзадач -->
        <DataGrid.RowDetailsTemplate>
            <DataTemplate>
                <ItemsControl ItemsSource="{Binding SubTasks}" Margin="37,2,0,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderBrush="#CCCCCC"
                                        BorderThickness="0,0,1,0" Margin="44,0,0,0"/>

                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Width="12" BorderBrush="#CCCCCC"
                                            BorderThickness="0,1,0,0" VerticalAlignment="Center"/>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           VerticalAlignment="Center" Foreground="#444"
                                           Margin="12,0,4,0" TextTrimming="CharacterEllipsis"/>

                                <!-- Години підзадачі: F1 -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding EstimatedHours, StringFormat={}{0:F1} ч.}"
                                           VerticalAlignment="Center" Foreground="Gray"/>

                                <TextBlock Grid.Column="4"
                                           Text="{Binding Deadline, StringFormat={}{0:dd.MM.yyyy}}"
                                           VerticalAlignment="Center" Foreground="Gray"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DataTemplate>
        </DataGrid.RowDetailsTemplate>

    </DataGrid>
</UserControl>
