<UserControl x:Class="WpfApp2.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataGrid x:Name="TasksGrid"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserResizeRows="False"
          SelectionMode="Single"
          IsReadOnly="True"
          SelectionUnit="FullRow"
          Margin="5"
          MinRowHeight="48"
          FontSize="14"
          HorizontalScrollBarVisibility="Disabled"
          RowDetailsVisibilityMode="Collapsed"
          ColumnHeaderHeight="40"
          RowStyle="{StaticResource DataGridRowNoHighlight}">

        <DataGrid.ColumnHeaderStyle>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="FontSize"                   Value="13"/>
                <Setter Property="FontWeight"                 Value="SemiBold"/>
                <Setter Property="Foreground"                 Value="#534AB7"/>
                <Setter Property="Background"                 Value="#F4F3FF"/>
                <Setter Property="Padding"                    Value="8,0"/>
                <Setter Property="BorderThickness"            Value="0,0,0,1"/>
                <Setter Property="BorderBrush"                Value="#E0DEFF"/>
            </Style>
        </DataGrid.ColumnHeaderStyle>

        <DataGrid.Columns>

            <!-- Стрілка -->
            <DataGridTemplateColumn Width="50">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <ToggleButton x:Name="ExpanderToggle"
                                  Background="Transparent" BorderThickness="0"
                                  Cursor="Hand"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding IsSplit,
                                      Converter={StaticResource BoolToVisibility}}"
                                  Checked="ExpanderToggle_Checked"
                                  Unchecked="ExpanderToggle_Unchecked"
                                  Tag="{Binding}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">
                                        <Path x:Name="Arrow"
                                          Data="M 0 0 L 6 4 L 0 8 Z"
                                          Fill="#534AB7"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Arrow" Property="Fill" Value="#3C3489"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                        Storyboard.TargetName="Arrow"
                                                        Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                        To="90" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                        Storyboard.TargetName="Arrow"
                                                        Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                        To="0" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Назва -->
            <DataGridTemplateColumn Header="Назва" Width="2*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"
                               FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="8,0"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Опис -->
            <DataGridTemplateColumn Header="Опис" Width="1.5*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Description}"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Foreground="Gray" Margin="4,0"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Години (без "ч.") -->
            <DataGridTemplateColumn Header="Години" Width="0.8*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding EstimatedHours, StringFormat={}{0:F1}}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Дедлайн -->
            <DataGridTemplateColumn Header="Дедлайн" Width="1*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Deadline, StringFormat={}{0:dd.MM.yyyy}}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Прогрес" Width="1.5*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Grid Margin="8,0" VerticalAlignment="Center">
                            <!-- Для розбитих задач — прогрес-бар -->
                            <StackPanel
                    Visibility="{Binding IsSplit,
                        Converter={StaticResource BoolToVisibility}}">
                                <ProgressBar
                        Value="{Binding Progress, Mode=OneWay}"
                        Height="10"
                        HorizontalAlignment="Stretch"
                        Foreground="#534AB7"
                        Background="#E0DEFF"
                        BorderThickness="0"/>
                                <TextBlock
                        Text="{Binding Progress, StringFormat={}{0}%, Mode=OneWay}"
                        FontSize="11" Foreground="Gray"
                        HorizontalAlignment="Center"
                        Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Для звичайних задач — чекбокс -->
                            <CheckBox
                    IsChecked="{Binding IsChecked,
                        UpdateSourceTrigger=PropertyChanged}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsSplit,
                        Converter={StaticResource InverseBoolToVisibility}}"/>
                        </Grid>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Дії -->
            <DataGridTemplateColumn Header="Дії" Width="1.4*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Button Style="{StaticResource ImageButtonStyle}"
                                Width="36" Height="36" Margin="2"
                                Cursor="Hand" ToolTip="Редагувати"
                                Click="Edit_Click" Tag="{Binding}">
                                <Image Source="/Images/edit.png" Width="22" Height="22"/>
                            </Button>
                            <Button Style="{StaticResource ImageButtonStyle}"
                                Width="36" Height="36" Margin="2"
                                Cursor="Hand" ToolTip="Видалити"
                                Click="Delete_Click" Tag="{Binding}">
                                <Image Source="/Images/delete.png" Width="22" Height="22"/>
                            </Button>
                            <Button Style="{StaticResource ImageButtonStyle}"
                                Width="36" Height="36" Margin="2"
                                Cursor="Hand" ToolTip="Розбити"
                                Click="Split_Click" Tag="{Binding}"
                                Visibility="{Binding IsSplit,
                                    Converter={StaticResource InverseBoolToVisibility}}">
                                <Image Source="/Images/split.png" Width="22" Height="22"/>
                            </Button>
                            <Button Style="{StaticResource ImageButtonStyle}"
                                Width="36" Height="36" Margin="2"
                                Cursor="Hand" ToolTip="Редагувати частини"
                                Click="EditParts_Click" Tag="{Binding}"
                                Visibility="{Binding IsSplit,
                                    Converter={StaticResource BoolToVisibility}}">
                                <Image Source="/Images/arrow.png" Width="22" Height="22"/>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

        </DataGrid.Columns>

        <!-- Підзадачі -->
        <DataGrid.RowDetailsTemplate>
            <DataTemplate>
                <ItemsControl ItemsSource="{Binding SubTasks}" Margin="50,2,0,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4" MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                    <Border Width="10" BorderBrush="#CCCCCC"
                                        BorderThickness="0,1,0,0"
                                        VerticalAlignment="Center"/>
                                    <CheckBox IsChecked="{Binding IsChecked,
                                              UpdateSourceTrigger=PropertyChanged}"
                                          VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="#444" Margin="8,0,4,0"
                                       TextTrimming="CharacterEllipsis"/>

                                <!-- Години без "ч." -->
                                <TextBlock Grid.Column="3"
                                       Text="{Binding EstimatedHours, StringFormat={}{0:F1}}"
                                       FontSize="13" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" Foreground="Gray"/>

                                <TextBlock Grid.Column="4"
                                       Text="{Binding Deadline, StringFormat={}{0:dd.MM.yyyy}}"
                                       FontSize="13" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" Foreground="Gray"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DataTemplate>
        </DataGrid.RowDetailsTemplate>

    </DataGrid>
</UserControl>
