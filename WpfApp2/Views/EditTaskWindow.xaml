<Window x:Class="WpfApp2.EditTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редагувати завдання"
        Height="650" Width="400"
        FontSize="18"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="White" 
            CornerRadius="12" 
            BorderThickness="0">
        
        <Border BorderBrush="#E0DEFF" 
                BorderThickness="1" 
                CornerRadius="12"
                Background="White">
            
            <StackPanel Margin="10">
                
                <Border Background="#534AB7" 
                        CornerRadius="8,8,0,0" 
                        Margin="-10,-10,-10,0"
                        Height="40"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <TextBlock Text="Редагувати завдання" 
                                   FontWeight="SemiBold" 
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                        <Button Content="✕" 
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            Click="Close_Click"/>
                    </Grid>
                </Border>

                <TextBlock Text="Назва завдання" Margin="0,10,0,5" />
                <TextBox x:Name="NameBox" Margin="0,0,0,5"  Padding="6,4"/>

                <TextBlock Text="Опис" Margin="0,5,0,5" />
                <TextBox x:Name="Description" Margin="0,0,0,5"  Padding="6,4" TextWrapping="Wrap"/>

                <TextBlock Text="Предмет" Margin="0,5,0,5" />
                <ComboBox x:Name="SubjectBox" Margin="0,0,0,5"  Padding="6,4"
                          DisplayMemberPath="Name" SelectedValuePath="Id"/>

                <TextBlock Text="Орієнтовний час (години)" Margin="0,5,0,5" />
                <TextBox x:Name="EstimatedBox" Margin="0,0,0,5"  Padding="6,4"/>

                <TextBlock Text="Кінцевий термін" Margin="0,5,0,5" />
                <DatePicker x:Name="DeadlinePicker" Margin="0,0,0,5" />

                <StackPanel Orientation="Horizontal" Margin="-6,5,0,2">
                    <CheckBox x:Name="TimeEnabledCheck"
                              Content="Вказати час здачі"
                              VerticalAlignment="Center"
                              Checked="TimeEnabledCheck_Changed"
                              Unchecked="TimeEnabledCheck_Changed"/>
                </StackPanel>

                <Grid x:Name="TimePanel" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="HourBox" Grid.Column="0"
                              IsEnabled="{Binding ElementName=TimeEnabledCheck, Path=IsChecked}"
                               Padding="4,2"/>
                    <TextBlock Grid.Column="1" Text=" : " 
                               VerticalAlignment="Center" Foreground="#534AB7" FontWeight="Bold"/>
                    <ComboBox x:Name="MinuteBox" Grid.Column="2"
                              IsEnabled="{Binding ElementName=TimeEnabledCheck, Path=IsChecked}"
                               Padding="4,2"/>
                </Grid>

                <TextBlock Text="Тип завдання" Margin="0,5,0,5" />
                <ComboBox x:Name="TypeBox" Margin="0,0,0,5"  Padding="6,4">
                    <ComboBoxItem Content="Без типу" IsSelected="True"/>
                    <ComboBoxItem Content="Лекція"/>
                    <ComboBoxItem Content="Лабораторна робота"/>
                    <ComboBoxItem Content="Самостійна робота"/>
                    <ComboBoxItem Content="Тест"/>
                    <ComboBoxItem Content="Курсовий проєкт"/>
                    <ComboBoxItem Content="Дипломний проєкт"/>
                    <ComboBoxItem Content="Семінар"/>
                    <ComboBoxItem Content="Практичне заняття"/>
                    <ComboBoxItem Content="Домашнє завдання"/>
                    <ComboBoxItem Content="Есе"/>
                    <ComboBoxItem Content="Презентація"/>
                    <ComboBoxItem Content="Іспит"/>
                    <ComboBoxItem Content="Контрольна робота"/>
                    <ComboBoxItem Content="Наукова робота"/>
                    <ComboBoxItem Content="Практика"/>
                </ComboBox>

                <Button Content="Зберегти зміни"
                        Margin="0,10,0,5" Click="Edit_Click"
                        Style="{StaticResource PrimaryButton}"
                         Padding="0,8" FontSize="18"/>
            </StackPanel>
        </Border>
    </Border>
</Window>