<UserControl x:Class="WpfApp2.Views.MiniCalendarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="400" Height="206">
    <StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="◀" Width="22" Height="20" FontSize="10"
                    Padding="0" Click="Prev_Click"/>
            <TextBlock x:Name="MonthLbl" FontSize="11" FontWeight="Bold"
                       Width="150" TextAlignment="Center"
                       VerticalAlignment="Center"/>
            <Button Content="▶" Width="22" Height="20" FontSize="10"
                    Padding="0" Click="Next_Click"/>
        </StackPanel>
        <UniformGrid x:Name="Grid" Rows="7" Columns="7"
            Height="230" Width="380"/>
    </StackPanel>
</UserControl>