<UserControl x:Class="WpfApp2.Views.MiniCalendarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="170">
    <StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
            <Button Content="◀" Width="22" Height="18" FontSize="9"
                    Padding="0" Click="Prev_Click"
                    Foreground="#534AB7" Background="Transparent"
                    BorderThickness="0" Cursor="Hand"/>
            <TextBlock x:Name="MonthLbl" FontSize="10" FontWeight="Bold"
                       Width="140" TextAlignment="Center"
                       VerticalAlignment="Center" Foreground="#534AB7"/>
            <Button Content="▶" Width="22" Height="18" FontSize="9"
                    Padding="0" Click="Next_Click"
                    Foreground="#534AB7" Background="Transparent"
                    BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <UniformGrid x:Name="Grid" Rows="7" Columns="7"
                     HorizontalAlignment="Stretch"
                     Height="148"
                     IsItemsHost="False"/>
    </StackPanel>
</UserControl>
