<UserControl x:Class="WpfApp2.Views.MiniCalendarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="200" Height="160">
    <StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="◀" Width="20" Height="18" FontSize="9"
            Padding="0" Click="Prev_Click"
            Foreground="#534AB7" Background="Transparent"
            BorderThickness="0" Cursor="Hand"/>
            <TextBlock x:Name="MonthLbl" FontSize="10" FontWeight="Bold"
               Width="120" TextAlignment="Center"
               VerticalAlignment="Center" Foreground="#534AB7"/>
            <Button Content="▶" Width="20" Height="18" FontSize="9"
            Padding="0" Click="Next_Click"
            Foreground="#534AB7" Background="Transparent"
            BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
        <UniformGrid x:Name="Grid" Rows="7" Columns="7"
            Height="148" Width="196" IsItemsHost="False"/>
    </StackPanel>
</UserControl>
